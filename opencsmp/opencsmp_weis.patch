+/** relative stopping tolerance of the pressure and temperature linear solves; the
+    solvers read their settings at every solve, so this takes effect immediately */
+template <uint32_t dim>
+void CVFEM_PHX_Scheme<dim>::SetLinearSolverRelativeTolerance(
+    double rtol)
+{
+    (void)rtol; // unused if no configurable backend is compiled in
+    for (SolverBundle* bundle : {&P_bundle, &T_bundle})
+    {
+#ifdef CSMP_WITH_SAMG_SOLVER
+        if (bundle->Kind() == SolverKind::SAMG)
+            bundle->SAMGSettings().Set_eps(rtol);
+#endif
+#if defined(CSMP_WITH_PETSC_SOLVER)
+        if (bundle->Kind() == SolverKind::PETSc)
+            bundle->PETScSettings().SetRelativeTolerance(rtol);
+#endif
+    }
+}
+
+/** Krylov iteration cap of the pressure and temperature linear solves (PETSc only) */
+template <uint32_t dim>
+void CVFEM_PHX_Scheme<dim>::SetLinearSolverMaximumIterations(
+    int max_iterations)
+{
+    (void)max_iterations; // unused if PETSc is not compiled in
+#if defined(CSMP_WITH_PETSC_SOLVER)
+    for (SolverBundle* bundle : {&P_bundle, &T_bundle})
+        if (bundle->Kind() == SolverKind::PETSc)
+            bundle->PETScSettings().SetMaximumIterations(max_iterations);
+#endif
+}
